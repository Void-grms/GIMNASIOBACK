{
  "name": "gimnasio-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "prod": "node dist/src/main",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:logica": "ts-node test/logica.test.ts",
    "test:asistencia-erp": "ts-node test/asistencia-erp.test.ts",
    "test:acceso": "ts-node test/acceso.test.ts",
    "test:auth-concurrencia": "ts-node test/auth-concurrencia.test.ts",
    "test:checkins-concurrencia": "ts-node test/checkins-concurrencia.test.ts",
    "test:membresias": "ts-node test/membresias.test.ts",
    "test:carga": "node scripts/probar-carga.cjs",
    "test:importacion": "ts-node test/importacion.test.ts",
    "importar:erp": "ts-node scripts/importar-erp.ts",
    "db:elegir": "node scripts/elegir-base.js",
    "db:seed:prod": "node dist/prisma/seed.js",
    "railway:build": "node scripts/elegir-base.js && prisma generate && nest build",
    "railway:predeploy": "node scripts/elegir-base.js && node scripts/migrar-acceso-erp.js && prisma db push --skip-generate && node dist/prisma/seed.js",
    "test:sunat": "ts-node test/sunat.test.ts",
    "test:sunat-pg": "node scripts/probar-sunat-pg.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "6.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "multer": "2.4.0",
    "qs": "6.16.1",
    "lodash": "4.18.1",
    "uuid@11.0.3": "11.1.1"
  }
}
