# SQLite en la PC de recepcion. Para PostgreSQL (Railway) basta poner la URL
# postgresql://... : scripts/elegir-base.js ajusta el provider de Prisma solo.
DATABASE_URL="file:./gimnasio.db"

# Cambia estos dos antes de produccion: con QR_SECRET se firman las credenciales.
JWT_SECRET="cambia-esto-en-produccion-por-favor"
QR_SECRET="secreto-hmac-para-los-codigos-qr"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Nombre que aparece en los mensajes de WhatsApp
GIMNASIO_NOMBRE="FORCES GYM"

# Dias de gracia para que una renovacion atrasada no le quite dias al socio
DIAS_GRACIA=7

# Horas tras las cuales se cierra sola la sesion de quien no marco salida
HORAS_MAX_DENTRO=6

# Ventana de avisos de vencimiento
AVISO_DIAS_ANTES=3
AVISO_DIAS_DESPUES=7

# --- Solo en un servidor publico (Railway) ---------------------------------
# NODE_ENV=production        sin claves de ejemplo ni socios inventados
# TRUST_PROXY=1              la IP real llega por X-Forwarded-For
# UPLOADS_DIR=/data/uploads  fotos en un volumen persistente
# ADMIN_PASSWORD=...         clave inicial del admin; si falta se genera al
# RECEPCION_PASSWORD=...     azar y se imprime una vez en el log del deploy
# SEED_EJEMPLOS=true         cargar los 3 socios de ejemplo igual
